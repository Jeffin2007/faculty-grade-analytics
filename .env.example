# =============================================================================
# Faculty Grade Analytics Portal - Environment Configuration (.env)
# =============================================================================

# AI Provider Mode: ollama_cloud | ollama_local | deterministic
AI_PROVIDER=ollama_cloud

# Ollama Cloud API Key (Required for ollama_cloud provider)
# Obtain key from https://ollama.com/account/keys
OLLAMA_API_KEY=your_secret_ollama_api_key_here

# Ollama Model Name (Default: llama3)
OLLAMA_MODEL=llama3

# Optional: Host URL override
# OLLAMA_HOST=https://api.ollama.com

# Server Settings
HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_MB=20
